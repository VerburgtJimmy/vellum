# Keep the installed package lean. Everything below is development or CI
# material that no application needs inside vendor/.
#
# docs/ itself ships: it is the package's own documentation and can be pointed
# at with vellum.path. Only the README screenshots are dropped, since GitHub
# renders those from the repository rather than from a release.

/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/composer.lock          export-ignore
/package-lock.json      export-ignore
/phpstan.neon           export-ignore
/phpunit.xml            export-ignore
/pint.json              export-ignore
/testbench.yaml         export-ignore
/scripts                export-ignore
/tests                  export-ignore
/vite.anchor.config.js  export-ignore
/vite.config.js         export-ignore
/vite.focus.config.js   export-ignore
/vite.search.config.js  export-ignore
/docs/screenshots       export-ignore
/CONTRIBUTING.md        export-ignore
/CODE_OF_CONDUCT.md     export-ignore
