<div class="vellum-callout vellum-callout-tip" data-vellum-callout="tip"><span class="vellum-callout-icon vellum-callout-icon-tip" aria-hidden="true"></span><div class="vellum-callout-body"><div class="vellum-callout-content"><div class="vellum-tabs" data-vellum-tabs="" x-data="{ active: &quot;a&quot;, set(id) { this.active = id } }"><div class="vellum-tabs-list" role="tablist"><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'a'" @click="set('a')" id="vellum-tab-a">A</button><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'b'" @click="set('b')" id="vellum-tab-b">B</button></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'a'" aria-labelledby="vellum-tab-a"><p>Alpha</p></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'b'" aria-labelledby="vellum-tab-b"><p>Beta</p></div></div></div></div></div>