<div class="vellum-callout vellum-callout-tip" data-vellum-callout="tip"><span class="vellum-callout-rail" aria-hidden="true"></span><span class="vellum-callout-icon vellum-callout-icon-tip" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" stroke="none" stroke-width="0" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="vellum-callout-glyph"><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z" /></svg></span><div class="vellum-callout-body"><div class="vellum-callout-content"><div class="vellum-tabs" data-vellum-tabs="" x-data="{ active: &quot;a&quot;, set(id) { this.active = id } }"><div class="vellum-tabs-list" role="tablist"><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'a'" @click="set('a')" id="vellum-tab-a">A</button><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'b'" @click="set('b')" id="vellum-tab-b">B</button></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'a'" aria-labelledby="vellum-tab-a"><p>Alpha</p></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'b'" aria-labelledby="vellum-tab-b" x-cloak=""><p>Beta</p></div></div></div></div></div>