<div class="vellum-tabs" data-vellum-tabs="" x-data="{ active: (typeof localStorage !== &quot;undefined&quot; &amp;&amp; localStorage.getItem(&quot;vellum-tabs-pkg-manager&quot;)) || &quot;npm&quot;, set(id) { this.active = id; localStorage.setItem(&quot;vellum-tabs-pkg-manager&quot;, id) } }" data-persist="pkg-manager"><div class="vellum-tabs-list" role="tablist"><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'npm'" @click="set('npm')" id="vellum-tab-npm">npm</button><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'pnpm'" @click="set('pnpm')" id="vellum-tab-pnpm">pnpm</button></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'npm'" aria-labelledby="vellum-tab-npm"><div class="vellum-code" data-vellum-code=""><button type="button" class="vellum-code-copy" x-data="{ copied: false }" @click="navigator.clipboard.writeText($el.closest('[data-vellum-code]').querySelector('code').innerText); copied = true; setTimeout(() =&gt; copied = false, 1500)" :aria-label="copied ? 'Copied' : 'Copy code'"><span class="vellum-code-copy-icon" x-show="!copied" aria-hidden="true">Copy</span><span class="vellum-code-check-icon" x-show="copied" x-cloak="" aria-hidden="true">Copied</span></button><pre><code class="language-bash"><span class="vellum-code-line">npm install vellum</span>
<span class="vellum-code-line"></span></code></pre></div></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'pnpm'" aria-labelledby="vellum-tab-pnpm"><div class="vellum-code" data-vellum-code=""><button type="button" class="vellum-code-copy" x-data="{ copied: false }" @click="navigator.clipboard.writeText($el.closest('[data-vellum-code]').querySelector('code').innerText); copied = true; setTimeout(() =&gt; copied = false, 1500)" :aria-label="copied ? 'Copied' : 'Copy code'"><span class="vellum-code-copy-icon" x-show="!copied" aria-hidden="true">Copy</span><span class="vellum-code-check-icon" x-show="copied" x-cloak="" aria-hidden="true">Copied</span></button><pre><code class="language-bash"><span class="vellum-code-line">pnpm add vellum</span>
<span class="vellum-code-line"></span></code></pre></div></div></div>