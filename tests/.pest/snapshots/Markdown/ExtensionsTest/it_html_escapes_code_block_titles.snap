<div class="vellum-code" data-vellum-code=""><div class="vellum-code-header"><span class="vellum-code-title">&lt;script&gt;alert(1)&lt;/script&gt;</span></div><button type="button" class="vellum-code-copy" x-data="{ copied: false }" @click="navigator.clipboard.writeText($el.closest('[data-vellum-code]').querySelector('code').innerText); copied = true; setTimeout(() =&gt; copied = false, 1500)" :aria-label="copied ? 'Copied' : 'Copy code'"><span class="vellum-code-copy-icon" x-show="!copied" aria-hidden="true">Copy</span><span class="vellum-code-check-icon" x-show="copied" x-cloak="" aria-hidden="true">Copied</span></button><pre><code class="language-php"><span class="vellum-code-line"><span class="hl-keyword">echo</span> 1;</span>
<span class="vellum-code-line"></span></code></pre></div>