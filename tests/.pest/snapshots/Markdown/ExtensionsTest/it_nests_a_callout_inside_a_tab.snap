<div class="vellum-tabs" data-vellum-tabs="" x-data="{ active: &quot;one&quot;, set(id) { this.active = id } }"><div class="vellum-tabs-list" role="tablist"><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'one'" @click="set('one')" id="vellum-tab-one">One</button><button type="button" class="vellum-tabs-trigger" role="tab" :aria-selected="active === 'two'" @click="set('two')" id="vellum-tab-two">Two</button></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'one'" aria-labelledby="vellum-tab-one"><div class="vellum-callout vellum-callout-note" data-vellum-callout="note"><span class="vellum-callout-icon vellum-callout-icon-note" aria-hidden="true"></span><div class="vellum-callout-body"><div class="vellum-callout-content"><p>Inside tab</p></div></div></div></div><div class="vellum-tabs-panel" role="tabpanel" x-show="active === 'two'" aria-labelledby="vellum-tab-two" x-cloak=""><p>Second panel</p></div></div>