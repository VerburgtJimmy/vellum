{
    "name": "jimmyverburgt/vellum",
    "description": "Markdown documentation sites for Laravel",
    "keywords": [
        "laravel",
        "documentation",
        "markdown",
        "docs",
        "vellum"
    ],
    "homepage": "https://github.com/VerburgtJimmy/vellum",
    "license": "MIT",
    "authors": [
        {
            "name": "Jimmy Verburgt",
            "email": "hey@jimmyverburgt.com",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hey@jimmyverburgt.com",
        "issues": "https://github.com/VerburgtJimmy/vellum/issues",
        "source": "https://github.com/VerburgtJimmy/vellum",
        "docs": "https://github.com/VerburgtJimmy/vellum#readme",
        "security": "https://github.com/VerburgtJimmy/vellum/security/policy"
    },
    "require": {
        "php": "^8.4",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "league/commonmark": "^2.6",
        "symfony/yaml": "^7.0|^8.0",
        "tales-from-a-dev/tailwind-merge-php": "^0.4",
        "tempest/highlight": "^2.28"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "laravel/scout": "^11.8",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Vellum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vellum\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "laravel/scout": "Required when vellum.search.driver is scout (Meilisearch or Typesense)."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vellum\\VellumServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --colors=always",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test",
        "docs:build": "CACHE_STORE=array VELLUM_PATH=\"$PWD/docs\" VELLUM_MODEL_PATH=\"$PWD/storage/vellum/models\" VELLUM_CHANGELOG=\"$PWD/CHANGELOG.md\" vendor/bin/testbench vellum:build"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
