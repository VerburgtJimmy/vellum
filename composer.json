{
    "name": "jimmyverburgt/vellum",
    "description": "Fumadocs-style documentation sites from Markdown for Laravel",
    "keywords": [
        "laravel",
        "documentation",
        "markdown",
        "docs",
        "vellum"
    ],
    "homepage": "https://github.com/VerburgtJimmy/vellum",
    "license": "MIT",
    "authors": [
        {
            "name": "Jimmy Verburgt",
            "email": "jimmy@jimmyverburgt.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/VerburgtJimmy/vellum/issues",
        "source": "https://github.com/VerburgtJimmy/vellum"
    },
    "require": {
        "php": "^8.4",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0",
        "league/commonmark": "^2.6",
        "symfony/yaml": "^7.0|^8.0",
        "tales-from-a-dev/tailwind-merge-php": "^0.4",
        "tempest/highlight": "^2.28"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Vellum\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vellum\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vellum\\VellumServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --colors=always",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
        "format": "vendor/bin/pint",
        "format:test": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
